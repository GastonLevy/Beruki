{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Detalle de corte de caja
{% endblock %}

{% block main %}

    <div class="mb-4">
        <a
            href="{{ ea_url()
                .setRoute('admin_cash_cuts_pending')
            }}"
            class="btn btn-secondary btn-sm"
        >
            Volver
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">
                Usuario: {{ user.username }}
            </h5>

            <p class="mb-1">
                <strong>Total pendiente:</strong>
                ${{ totalAmount|number_format(2, ',', '.') }}
            </p>

            <p class="mb-1">
                <strong>Comisión del usuario:</strong>
                ${{ userCommissionAmount|number_format(2, ',', '.') }}
            </p>

            <p class="mb-1">
                <strong>Total a retirar:</strong>
                ${{ amountToWithdraw|number_format(2, ',', '.') }}
            </p>

            <p class="mb-0">
                <strong>Cantidad de pagos:</strong>
                {{ payments|length }}
            </p>
        </div>
    </div>

    <table class="table datagrid table-hover">
        <thead>
            <tr>
                <th>Fecha de pago</th>
                <th>Abonado</th>
                <th>Cliente</th>
                <th>Monto</th>
            </tr>
        </thead>

        <tbody>
            {% for payment in payments %}
                <tr
                    role="button"
                    style="cursor: pointer;"
                    onclick="window.open('{{ ea_url()
                        .setRoute('admin_customer_detail_view', { customerId: payment.customer.id })
                    }}', '_blank')"
                >
                    <td>
                        {{ payment.paidAt|date('d/m/Y H:i') }}
                    </td>

                    <td>
                        {{ payment.customer.subscriberNumber }}
                    </td>

                    <td>
                        {{ payment.customer.fullName }}
                    </td>

                    <td>
                        ${{ payment.amount|number_format(2, ',', '.') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No hay pagos pendientes para este usuario.
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if payments|length > 0 %}
        <form
            method="post"
            action="{{ ea_url()
                .setRoute('admin_cash_cuts_close', { userId: user.id })
            }}"
            onsubmit="return confirm('¿Confirmar corte de caja para este usuario?');"
            class="text-end mt-4"
        >
            <button type="submit" class="btn btn-primary">
                Confirmar corte de caja
            </button>
        </form>
    {% endif %}

{% endblock %}