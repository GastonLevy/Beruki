{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Detalle de corte de caja
{% endblock %}

{% block main %}

    <div class="mb-4">
        <a
            href="{{ ea_url()
                .setRoute('admin_cash_cuts_pending')
            }}"
            class="btn btn-secondary btn-sm"
        >
            Volver
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h5 class="card-title mb-1">
                        Corte pendiente
                    </h5>

                    <div class="text-muted">
                        Caja pendiente de cierre
                    </div>
                </div>

                <div class="text-end">
                    <div class="text-muted small">
                        Usuario
                    </div>

                    <strong>
                        {{ user.username }}
                    </strong>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small mb-1">
                            Total recaudado
                        </div>

                        <div class="fs-5 fw-bold">
                            ${{ totalAmount|number_format(2, ',', '.') }}
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small mb-1">
                            Comisión del usuario
                        </div>

                        <div class="fs-5 fw-bold">
                            ${{ userCommissionAmount|number_format(2, ',', '.') }}
                        </div>

                        <div class="text-muted small">
                            {{ userCommissionPercentage|number_format(2, ',', '.') }}%
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small mb-1">
                            Total a retirar
                        </div>

                        <div class="fs-5 fw-bold">
                            ${{ amountToWithdraw|number_format(2, ',', '.') }}
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small mb-1">
                            Abonados cobrados
                        </div>

                        <div class="fs-5 fw-bold">
                            {{ payments|length }}
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="card">
        <div class="card-body p-4">

            <h5 class="card-title mb-3">
                Cobros de abonados incluidos en el corte
            </h5>

            <table class="table datagrid table-hover mb-0">
                <thead>
                    <tr>
                        <th>Fecha de pago</th>
                        <th>Abonado</th>
                        <th>Cliente</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>

                <tbody>
                    {% for payment in payments %}
                        <tr
                            role="button"
                            style="cursor: pointer;"
                            onclick="window.open('{{ ea_url()
                                .setRoute('admin_customer_detail_view', { customerId: payment.customer.id })
                            }}', '_blank')"
                        >
                            <td>
                                {{ payment.paidAt|date('d/m/Y H:i') }}
                            </td>

                            <td>
                                {{ payment.customer.subscriberNumber }}
                            </td>

                            <td>
                                {{ payment.customer.fullName }}
                            </td>

                            <td class="text-end">
                                ${{ payment.amount|number_format(2, ',', '.') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                No hay pagos pendientes para este usuario.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

        </div>
    </div>

    {% if payments|length > 0 %}
        <form
            method="post"
            action="{{ ea_url()
                .setRoute('admin_cash_cuts_close', { userId: user.id })
            }}"
            onsubmit="return confirm('¿Confirmar corte de caja para este usuario?');"
            class="text-end mt-4"
        >
            <button type="submit" class="btn btn-primary">
                Confirmar corte de caja
            </button>
        </form>
    {% endif %}

{% endblock %}