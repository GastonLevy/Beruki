{% extends 'base.html.twig' %}

{% block title %}Iniciar sesión{% endblock %}

{% block body %}

    <div class="admin-login-page">

        <div class="admin-login-card">

            <div class="admin-login-header">

                <img
                    src="{{ asset('img/AlsinaLogo.png') }}"
                    alt="Alsina Telecomunicaciones"
                    class="admin-login-logo"
                >

                <p class="admin-login-description">
                    Iniciá sesión para acceder al panel de administración
                </p>

            </div>

            {% if error %}
                <div class="admin-alert admin-alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="admin-alert admin-alert-secondary">
                    Sesión iniciada como {{ app.user.userIdentifier }}.
                    <a href="{{ logout_path() }}">Cerrar sesión</a>
                </div>
            {% endif %}

            <form method="post" class="admin-login-form">

                <div class="admin-form-group">

                    <label for="username" class="admin-form-label">
                        Usuario
                    </label>

                    <input
                        type="text"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="admin-form-control"
                        autocomplete="username"
                        required
                        autofocus
                    >

                </div>

                <div class="admin-form-group">

                    <label for="password" class="admin-form-label">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="admin-form-control"
                        autocomplete="current-password"
                        required
                    >

                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button class="admin-login-button" type="submit">
                    Iniciar sesión
                </button>

            </form>

        </div>

    </div>

    <style>
        :root {
            --app-bg: #f4f5f7;
            --app-surface: #ffffff;
            --app-text: #1f1f24;
            --app-text-muted: #6b7280;
            --app-border: #e5e7eb;
            --app-primary: #673de6;
            --app-primary-hover: #5025d1;
            --app-primary-soft: rgba(103, 61, 230, 0.15);
            --app-radius-md: 0.8rem;
            --app-radius-lg: 1.25rem;
        }

        body {
            margin: 0;
            background-color: var(--app-bg);
            color: var(--app-text);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .admin-login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background-color: var(--app-bg);
        }

        .admin-login-card {
            width: 100%;
            max-width: 34rem;
            padding: 2rem;
            border: 1px solid var(--app-border);
            border-radius: var(--app-radius-lg);
            background-color: var(--app-surface);
            box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.08);
        }

        .admin-login-header {
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .admin-login-logo {
            width: 100%;
            max-width: 24rem;
            height: auto;
            margin-bottom: 1rem;
            object-fit: contain;
        }

        .admin-login-description {
            margin: 0;
            color: var(--app-text-muted);
            font-size: 0.95rem;
        }

        .admin-login-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .admin-form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .admin-form-label {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--app-text);
        }

        .admin-form-control {
            width: 100%;
            box-sizing: border-box;
            padding: 0.85rem 1rem;
            border: 1px solid var(--app-border);
            border-radius: var(--app-radius-md);
            background-color: var(--app-surface);
            color: var(--app-text);
            font-size: 1rem;
            outline: none;
        }

        .admin-form-control:focus {
            border-color: var(--app-primary);
            box-shadow: 0 0 0 0.2rem var(--app-primary-soft);
        }

        .admin-login-button {
            width: 100%;
            margin-top: 0.5rem;
            padding: 0.9rem 1rem;
            border: 0;
            border-radius: var(--app-radius-md);
            background-color: var(--app-primary);
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
        }

        .admin-login-button:hover,
        .admin-login-button:focus {
            background-color: var(--app-primary-hover);
        }

        .admin-alert {
            margin-bottom: 1rem;
            padding: 0.85rem 1rem;
            border-radius: var(--app-radius-md);
            font-size: 0.9rem;
        }

        .admin-alert-danger {
            color: #842029;
            background-color: #f8d7da;
        }

        .admin-alert-secondary {
            color: var(--app-text);
            background-color: #f1f3f5;
        }

        .admin-alert a {
            color: var(--app-primary);
            font-weight: 700;
            text-decoration: none;
        }

        .admin-alert a:hover {
            color: var(--app-primary-hover);
        }

        @media (max-width: 576px) {
            .admin-login-card {
                max-width: 100%;
                padding: 1.5rem;
            }

            .admin-login-logo {
                max-width: 20rem;
            }
        }
    </style>

{% endblock %}